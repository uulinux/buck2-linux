    ],
)

genrule(
    name = 'libz-gzread',
    out = 'gzread.c',
    srcs = {
        'gzread.c.in': ':src[gzread.c.in]',
    },
    cmd = """
    cp $(location :src[gzread.c.in]) $OUT
    sed -i 's/@ZLIB_SYMBOL_PREFIX@//g' $OUT
    """
)

