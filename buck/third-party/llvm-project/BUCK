LLVM_VERSION = "21.0.0.git"
LLVM_VERSION_MAJOR = LLVM_VERSION.split(".")[0]
LLVM_VERSION_MINOR = LLVM_VERSION.split(".")[1]
LLVM_VERSION_PATCH = LLVM_VERSION.split(".")[2]


compiler_flags = select({
    "DEFAULT": [
        "-DLLVM_ON_UNIX",
        "-DHAVE_UNISTD_H",
        "-DHAVE_SYSEXITS_H",
        "-DHAVE_PTHREAD_H",
        f"-DLLVM_VERSION_STRING=\"{LLVM_VERSION}\"",
